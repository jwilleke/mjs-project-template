{
  "name": "@jwilleke/agent-kit",
  "version": "1.5.0",
  "description": "Agent commands and document formats for repos in any language, with a drift checker",
  "keywords": [
    "claude",
    "agents",
    "ai",
    "template",
    "conventions"
  ],
  "homepage": "https://github.com/jwilleke/mjs-project-template#readme",
  "bugs": "https://github.com/jwilleke/mjs-project-template/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwilleke/mjs-project-template.git",
    "directory": "packages/agent-kit"
  },
  "license": "ISC",
  "author": "Jim Willeke",
  "type": "module",
  "bin": {
    "agent-kit": "./bin/kit.mjs"
  },
  "exports": {
    ".": "./bin/kit.mjs",
    "./kit-files.tsv": "./kit-files.tsv",
    "./commands/*": "./commands/*",
    "./templates/*": "./templates/*"
  },
  "files": [
    "bin/",
    "commands/",
    "templates/",
    "kit-files.tsv",
    "kit-version.txt",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
